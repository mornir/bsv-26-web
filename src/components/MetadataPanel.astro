---
import { Share2, RotateCcwClock, Glasses, BookOpenText } from '@lucide/astro'

interface Props {
  articleNumber: number
  hierarchy: Hierarchy
}

const { articleNumber, hierarchy } = Astro.props

//TODO: how to handle Abschnitte??

/* const openInContextURL = hierarchy.reduce((currentPath, item) => {
  // Exclude Abschnitte
  if (!item.link || item.link === '#') {
    return currentPath
  }
  return item.link
}, '')
 */

// Check if hierarchy contains a chapter
const openInContextURL =
  hierarchy.length > 1 ? hierarchy[1].link : hierarchy[0].link
---

<div class="bg-surface border-l border-slate-200">
  <aside class="p-6 sticky top-24 h-fit">
    <h4 class="text-xs uppercase font-bold tracking-widest text-primary mb-4">
      Gliederung
    </h4>
    <div class="flex flex-col gap-4 mb-5">
      {
        hierarchy.map((item) => (
          <div>
            <p class="text-xxs text-outline uppercase font-medium tracking-wide mb-1 ">
              {item!.heading}
            </p>
            <p class="text-sm text-on-surface font-medium leading-normal">
              {item!.name}
            </p>
          </div>
        ))
      }
    </div>
    <div class="pt-6 border-t border-slate-300/30 mt-6">
      <h4 class="text-xs uppercase font-bold tracking-widest text-primary mb-4">
        ANFRAGEN
      </h4>
      <ul class="flex flex-col gap-3">
        <li>
          <a class="flex flex-col" href="#">
            <span
              class="text-xxs text-slate-500 uppercase font-bold tracking-tight"
              >12-006</span
            >
            <span class="text-sm text-primary transition-colors hover:underline"
              >Feuerwiderstand von Tragwerken</span
            >
          </a>
        </li>
        <li>
          <a class="flex flex-col" href="#">
            <span
              class="text-xxs text-slate-500 uppercase font-bold tracking-tight"
              >14-029</span
            >
            <span class="text-sm text-primary transition-colors hover:underline"
              >Aufbringen mineralischer Dämmung auf bestehende brennbare Dämmung
              an Fassaden</span
            >
          </a>
        </li>
      </ul>
    </div>
    <div class="pt-6 border-t border-slate-300/30 mt-6">
      <h4 class="text-xs uppercase font-bold tracking-widest text-primary mb-4">
        Aktionen
      </h4>
      <div class="flex flex-col gap-4">
        <a
          class="text-sm text-primary font-semibold hover:underline flex items-center gap-2"
          href={`${openInContextURL}#art-${articleNumber}`}
        >
          <BookOpenText class="size-4" /> Artikel im Regelwerk ansehen</a
        >
        <a
          class="text-sm text-primary font-semibold hover:underline flex items-center gap-2"
          href="vergleich/"
        >
          <Glasses class="size-4" /> Sprachversionen vergleichen</a
        >
        <a
          class="text-sm text-primary font-semibold hover:underline flex items-center gap-2"
          href="#"
        >
          <Share2 class="size-4" /> Artikel teilen</a
        >
        <a
          class="text-sm text-primary font-semibold hover:underline flex items-center gap-2"
          href="#"
        >
          <RotateCcwClock class="size-4" /> Verlauf ansehen
        </a>
      </div>
    </div>
  </aside>
</div>
