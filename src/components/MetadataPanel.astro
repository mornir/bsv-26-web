---
import { Share2, History, SquareArrowOutUpRight, Glasses } from '@lucide/astro'
import { formatHeading } from '@/i18n/utils'
---

<div class="bg-surface border-l border-slate-200">
  <aside class="p-6 sticky top-24 h-fit">
    <h4 class="text-xs uppercase font-bold tracking-widest text-primary mb-4">
      Gliederung
    </h4>
    <div class="flex flex-col gap-4 mb-5">
      <div>
        <p
          class="text-xs text-outline uppercase font-bold tracking-tighter mb-1"
        >
          3. Titel
        </p>
        <p class="text-sm text-on-surface font-medium leading-normal">
          Nachweis des Sicherheitsniveaus
        </p>
      </div>
      <div>
        <p
          class="text-xs text-outline uppercase font-bold tracking-tighter mb-1"
        >
          1. Kapitel
        </p>
        <p class="text-sm text-on-surface font-medium leading-normal">
          Grundsätze
        </p>
      </div>
    </div>
    <div class="pt-6 border-t border-slate-300/30 mt-6">
      <h4 class="text-xs uppercase font-bold tracking-widest text-primary mb-4">
        ANFRAGEN
      </h4>
      <ul class="flex flex-col gap-3">
        <li>
          <a
            class="text-sm text-outline hover:text-primary flex items-center gap-2 transition-colors"
            href="#"
          >
            <SquareArrowOutUpRight class="size-3" />
            Art. 36 Grundsätze
          </a>
        </li>
        <li>
          <a
            class="text-sm text-outline hover:text-primary flex items-center gap-2 transition-colors"
            href="#"
          >
            <SquareArrowOutUpRight class="size-3" />
            Art. 38 Zuständigkeiten
          </a>
        </li>
      </ul>
    </div>
    <div class="pt-6 border-t border-slate-300/30 mt-6">
      <h4 class="text-xs uppercase font-bold tracking-widest text-primary mb-4">
        Aktionen
      </h4>
      <div class="flex flex-col gap-4">
        <a
          class="text-sm text-primary font-semibold hover:underline flex items-center gap-2"
          href="#"
        >
          <Glasses class="size-4" /> Übersetzungen vergleichen</a
        >
        <a
          class="text-sm text-primary font-semibold hover:underline flex items-center gap-2"
          href="#"
        >
          <Share2 class="size-3" /> Artikel teilen</a
        >
        <a
          class="text-sm text-primary font-semibold hover:underline flex items-center gap-2"
          href="#"
        >
          <History class="size-4" /> Verlauf ansehen
        </a>
      </div>
    </div>
  </aside>
</div>
