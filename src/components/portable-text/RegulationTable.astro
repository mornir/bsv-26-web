---
import Tooltip from '@/components/Tooltip.astro'

const { desc, requirements } = Astro.props.node
---

<table class="law-table">
  <thead>
    <tr>
      <td rowspan={desc ? '2' : '1'}>
        <p>Bst.</p>
      </td>
      <td rowspan={desc ? '2' : '1'}>
        <p>System</p>
      </td>
      <td rowspan={desc ? '2' : '1'}>
        <p>Systemeigenschaft</p>
      </td>
      <td rowspan={desc ? '2' : '1'}>
        <p>
          <Tooltip message="Schutzgut Personen">P</Tooltip>
        </p>
      </td>
      <td rowspan={desc ? '2' : '1'}>
        <p><Tooltip message="Schutzgut Gebäude">G</Tooltip></p>
      </td>
      {
        desc && (
          <td colspan={requirements.length}>
            <p class="text-center">{desc}</p>
          </td>
        )
      }
    </tr>
    <tr>
      {
        requirements.map((req: string) => (
          <td>
            <p class="text-center">{req}</p>
          </td>
        ))
      }
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>
