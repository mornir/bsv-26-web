---
import { getLocaleUrl, getLocale } from 'astro-i18n-aut'

const locale = getLocale(Astro.url)

// IMPORTANT: normalize .html output
const pathname = Astro.url.pathname.replace(/\.html$/, '')

const { text = 'TEXT', slug = '/' } = Astro.props

const path = `/${slug}`

// also normalize target path just in case
const normalizedPath = path.replace(/\/$/, '') || '/'
---

<a
  href={getLocaleUrl(path, locale)}
  class={`font-bold transition-colors duration-200 hover:text-primary uppercase tracking-wider ${
    pathname === normalizedPath
      ? 'text-primary  border-b-2 border-primary'
      : 'text-outline hover:underline'
  }`}
>
  {text}
</a>
