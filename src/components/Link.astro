---
import { getLocaleUrl, getLocale } from 'astro-i18n-aut'

const locale = getLocale(Astro.url)

const pathname = Astro.url.pathname

const { text = 'TEXT', slug = '/' } = Astro.props

const path = slug === '/' || slug === '' ? '/' : `/${slug}/`
---

<a
  href={getLocaleUrl(path, locale)}
  class={`font-semibold underline-offset-8 text-primary hover:underline decoration-2 ${
    pathname === path && 'font-semibold underline'
  }`}
>
  {text}
</a>
