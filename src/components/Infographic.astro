---
import { Section } from '@lucide/astro'

interface Props {
  number: number
  name: string
  link: { name: string; href: string }
  icon: typeof Section
}

const { number, name, link, icon: Icon } = Astro.props
---

<aside
  class="relative w-full overflow-hidden rounded-md border border-white/30 bg-slate-950/30 py-5 px-7 text-white backdrop-blur-sm md:flex-1"
  aria-label="Anzahl Artikel"
>
  <Icon
    aria-hidden="true"
    class="pointer-events-none absolute right-6 top-1/2 size-20 -translate-y-1/2 text-white opacity-10"
  />

  <div class="relative z-10 max-w-[78%]">
    <p class="grid grid-cols-[auto_1fr] gap-x-2 items-center">
      <span class="text-5xl font-bold">{number}</span>
      <span class="font-semibold text-slate-200 whitespace-pre"> {name}</span>
    </p>

    <a
      href={link.href}
      class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-white underline decoration-white/50 underline-offset-4 hover:decoration-white"
    >
      {link.name}
    </a>
  </div>
</aside>
