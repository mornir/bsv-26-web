---
import { X, Maximize } from '@lucide/astro'

const { name = '' } = Astro.props
---

<div x-data="tableModal" x-init="init" class="mt-2 mb-6">
  <!-- Trigger -->
  <div class="flex justify-end mb-4">
    <button
      x-show="showButton"
      @click="open = true"
      class="flex items-center gap-1.5 text-outline hover:text-primary transition-colors px-3 py-2 rounded border border-outline/20 hover:border-primary/30 bg-white cursor-pointer"
      title="Tabelle vergrössern"
    >
      <Maximize class="h-4 w-4" />
      <span class="uppercase font-bold font-sans text-xxs"> Vollbild</span>
    </button>
  </div>

  <div x-ref="scrollContainer" class="max-w-full overflow-x-auto">
    <slot />
  </div>

  <!-- Modal -->
  <template x-teleport="body">
    <div
      x-show="open"
      @keydown.escape.prevent.stop="open = false"
      role="dialog"
      aria-modal="true"
      aria-labelledby={name}
      class="fixed inset-0 z-30 overflow-y-auto"
    >
      <!-- Overlay -->
      <div x-show="open" x-transition.opacity class="fixed inset-0 bg-black/25">
      </div>

      <!-- Panel -->
      <div
        x-show="open"
        x-transition
        @click="open = false"
        class="relative flex min-h-screen items-center justify-center p-4"
      >
        <div
          @click.stop
          x-trap.noscroll.inert="open"
          class="relative max-h-[90vh] w-full max-w-7xl overflow-auto bg-white shadow-lg"
        >
          <!-- Header -->
          <div
            class="flex items-start justify-between border-b border-gray-200 bg-white px-6 py-4"
          >
            <h2>
              <span class="mb-1 block font-mono text-sm text-gray-500">
                Tabelle
              </span>
              <span class="block font-serif text-xl">{name}</span>
            </h2>

            <button
              type="button"
              @click="open = false"
              class="p-2 transition-colors hover:bg-gray-100"
            >
              <X class="h-6 w-6" aria-label="Close" />
            </button>
          </div>

          <!-- Content -->
          <div class="p-6">
            <slot />
          </div>
        </div>
      </div>
    </div>
  </template>
</div>

<script>
  document.addEventListener('alpine:init', () => {
    Alpine.data('tableModal', () => ({
      open: false,
      showButton: true,

      init() {
        this.$nextTick(() => {
          this.checkOverflow()

          const container = this.$refs.scrollContainer
          if (!container) return

          const observer = new ResizeObserver(() => this.checkOverflow())
          observer.observe(container)
        })
      },

      checkOverflow() {
        const container = this.$refs.scrollContainer
        if (!container) return

        this.showButton = container.scrollWidth <= container.clientWidth
      },
    }))
  })
</script>
