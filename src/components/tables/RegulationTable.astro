---
import TableModal from '@/components/portable-text/TableModal.astro'
import Tooltip from '@/components/Tooltip.astro'
import BasicRichText from '../portable-text/BasicRichText.astro'

const { desc, possibleRequirements, name, rows } = Astro.props.node
---

<TableModal name={name}>
  <table class="law-table hyphens-none">
    <thead>
      <tr>
        <th rowspan={desc ? '2' : '1'}>
          <p>Bst.</p>
        </th>
        <th rowspan={desc ? '2' : '1'}>
          <p>System</p>
        </th>
        <th rowspan={desc ? '2' : '1'}>
          <p>Systemeigenschaft</p>
        </th>
        <th rowspan={desc ? '2' : '1'}>
          <p>
            <Tooltip message="Schutzgut Personen im Gebäude">P</Tooltip>
          </p>
        </th>
        <th rowspan={desc ? '2' : '1'}>
          <p><Tooltip message="Schutzgut Gebäude">G</Tooltip></p>
        </th>
        {
          desc && (
            <th colspan={possibleRequirements.length}>
              <p class="text-center text-balance">{desc}</p>
            </th>
          )
        }
      </tr>
      <tr>
        {
          possibleRequirements.map((req: string) => (
            <th>
              <p class="text-center">{req}</p>
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row: any) => (
          <tr>
            <td>
              <p>{row.letter}.</p>
            </td>
            <td>
              <p>{row.system}</p>
            </td>
            <td>
              <BasicRichText blocks={row.systemProperty.de} />
            </td>
            <td>
              <p>—</p>
            </td>
            <td>
              <p>X</p>
            </td>

            {possibleRequirements.map((posReq: string) => {
              const requirement = row.requirements.find(
                (req: any) => req.name === posReq
              )

              if (requirement) {
                return (
                  <td class="text-center">
                    <BasicRichText blocks={requirement?.criterion?.de} />
                  </td>
                )
              }

              return (
                <td>
                  <p class="text-center">—</p>
                </td>
              )
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</TableModal>
