---
import BasicRichText from '@/components/portable-text/BasicRichText.astro'
import { Info } from '@lucide/astro'

const { desc, possibleRequirements, rows } = Astro.props

const assets = [
  {
    letter: 'P',
    legend: 'Schutzgut: Personen im Gebäude',
    key: 'peopleInBuilding',
    show: rows?.some((row: any) => row.protectedAssets?.peopleInBuilding),
  },
  {
    letter: 'G',
    legend: 'Schutzgut: Gebäude',
    key: 'buildings',
    show: rows?.some((row: any) => row.protectedAssets?.buildings),
  },

  {
    letter: 'I',
    legend: 'Schutzgut: Interventionskräfte',
    key: 'firefighters',
    show: rows?.some((row: any) => row.protectedAssets?.firefighters),
  },
]
---

<table class="law-table hyphens-none">
  <thead>
    <tr>
      <th rowspan={desc ? '2' : '1'}>
        <p>Bst.</p>
      </th>
      <th rowspan={desc ? '2' : '1'}>
        <p>System</p>
      </th>
      <th rowspan={desc ? '2' : '1'}>
        <p>Systemeigenschaft</p>
      </th>
      {
        assets
          .filter((asset) => asset.show)
          .map((pAsset) => (
            <th rowspan={desc ? '2' : '1'}>
              <button
                class="flex flex-col items-center cursor-help mt-3.5 w-full"
                type="button"
                x-tooltip
                data-message={pAsset.legend}
              >
                <span>{pAsset.letter}</span>
                <Info size={14} class:list={'text-slate-500'} />
              </button>
            </th>
          ))
      }
      {
        desc && (
          <th colspan={possibleRequirements.length}>
            <p class="text-center text-balance">{desc}</p>
          </th>
        )
      }
    </tr>
    {
      possibleRequirements.length && (
        <tr>
          {possibleRequirements.map((req: string) => (
            <th class="w-32">
              <p class="text-center">{req}</p>
            </th>
          ))}
        </tr>
      )
    }
  </thead>
  <tbody>
    {
      rows.map((row: any) => (
        <tr class="group">
          <td class="group-hover:bg-slate-200">
            <p>{row.letter}.</p>
          </td>
          <td class="group-hover:bg-slate-200">
            <p>{row.system}</p>
          </td>
          <td class="max-w-2xs text-left group-hover:bg-slate-200">
            <BasicRichText blocks={row.systemProperty.de} />
          </td>

          {assets
            .filter((asset) => asset.show)
            .map((pAsset) => (
              <td class="text-center">
                <p>{row.protectedAssets[pAsset.key] ? 'X' : '—'}</p>
              </td>
            ))}

          {possibleRequirements.map((posReq: string) => {
            const requirement = row.requirements?.find(
              (req: any) => req.name === posReq
            )

            if (requirement) {
              return (
                <td
                  class:list={[
                    'text-center font-semibold group-hover:bg-slate-200',
                    {
                      'bg-rf3': requirement.name === 'RF3',
                    },
                    { 'bg-rf2': requirement.name === 'RF2' },
                    {
                      'bg-rf1 text-white': requirement.name === 'RF1',
                    },
                  ]}
                >
                  <BasicRichText blocks={requirement?.criterion?.de} />
                </td>
              )
            }

            return (
              <td>
                <p class="text-center">—</p>
              </td>
            )
          })}
        </tr>
      ))
    }
  </tbody>
</table>
