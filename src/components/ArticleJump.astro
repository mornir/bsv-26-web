---
import { getLocale } from 'astro-i18n-aut'
const locale = getLocale(Astro.url) as LangKeys
---

<form
  x-data="jumpToArticle"
  @submit="if ($el.checkValidity()) { $event.preventDefault();  window.location.href = `/art/${number}/`}"
>
  <label for="article-number">Artikel</label>

  <input
    id="article-number"
    type="text"
    inputmode="numeric"
    pattern="(?:[1-9]|[1-9][0-9]|[1-6][0-9]{2}|7[0-1][0-9]|72[0-5])"
    autocomplete="off"
    x-model="number"
    @invalid="$event.target.setCustomValidity($event.target.validity.valueMissing ? 'Bitte geben Sie eine Artikelnummer ein.' : 'Bitte geben Sie eine Artikelnummer von 1 bis 725.')"
    @input="$event.target.setCustomValidity('')"
    required
    class="border"
  />

  <button type="submit">Öffnen</button>
</form>
