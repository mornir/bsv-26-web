---
interface Props {
  articleNumber: number
  crumbs: { heading: string; name: string; link: string }[]
}

const { crumbs, articleNumber } = Astro.props
---

<nav
  class="flex items-center gap-2 mb-8 text-[11px] font-medium tracking-wide uppercase text-outline"
>
  <a class="hover:text-primary transition-colors" href="/">Startseite</a>
  {
    crumbs.map((crumb) => (
      <Fragment>
        <span>/</span>
        <a class="hover:text-primary transition-colors" href={crumb.link}>
          {crumb.heading}
        </a>
      </Fragment>
    ))
  }
  <span>/</span>
  <span class="text-primary">Art. {articleNumber}</span>
</nav>
