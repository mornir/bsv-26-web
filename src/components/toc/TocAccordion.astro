---
import { ChevronDown, ChevronRight } from '@lucide/astro'

interface Props {
  number?: number
  name: string | undefined
  isOpen?: boolean
  isActive?: boolean
  class?: string
}

const { name, isOpen = false, isActive = false, class: className } = Astro.props
---

<div
  x-data={`{ expanded: ${isOpen} }`}
  x-id="['toc-accordion']"
  role="region"
  :aria-labelledby="$id('toc-accordion')"
>
  <button
    type="button"
    :id="$id('toc-accordion')"
    x-on:click="expanded = !expanded"
    :aria-expanded="expanded"
    class:list={[
      'flex w-full items-center pl-3 justify-between py-2 text-left text-slate-600 transition-colors hover:bg-blue-100',
      isActive && 'border-l-2 border-primary/60 bg-blue-50 pl-3 text-primary',
    ]}
    aria-current={isActive ? 'page' : undefined}
  >
    <span class:list={[className, isActive && 'text-primary']}>
      {name}
    </span>
    <ChevronDown x-show="expanded" class="size-4 flex-none" />
    <ChevronRight x-show="!expanded" class="size-4 flex-none" />
  </button>

  <div x-show="expanded" x-collapse>
    <div class="ml-2 space-y-2 border-l-2 border-blue-200">
      <slot />
    </div>
  </div>
</div>
