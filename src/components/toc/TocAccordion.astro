---
import { ChevronDown, ChevronRight } from '@lucide/astro'

interface Props {
  number?: number
  name: string | undefined
  href?: string
  isOpen?: boolean
  class?: string
}

const { name, href, isOpen = false, class: className } = Astro.props

//TODO: find a better way
const headingId = `toc-accordion-${Math.random().toString(36).slice(2, 9)}`
---

<div
  x-data={`{ expanded: ${isOpen} }`}
  role="region"
  aria-labelledby={headingId}
>
  <h3>
    <div
      class="flex items-center pr-4 text-slate-600 transition-colors hover:bg-blue-100"
    >
      <a
        href={href}
        class:list={[
          'min-w-0 flex-1 px-4 py-2 text-left',
          className,
          { 'pointer-events-none': !href },
        ]}>{name}</a
      >
      <button
        type="button"
        id={headingId}
        x-on:click="expanded = !expanded"
        :aria-expanded="expanded"
        aria-label={`Toggle ${name}`}
        class="flex-none p-2"
      >
        <ChevronDown x-show="expanded" class="size-4" />
        <ChevronRight x-show="!expanded" class="size-4" />
      </button>
    </div>
  </h3>

  <div x-show="expanded" x-collapse>
    <div class="ml-2 pl-2 space-y-2 border-l-2 border-blue-200">
      <slot />
    </div>
  </div>
</div>
