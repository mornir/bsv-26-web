---
interface Props {
  slug: string
  number: number
  name: string | undefined
}

const { slug, number, name } = Astro.props

const pathname = Astro.url.pathname
---

<a
  href={slug}
  class:list={[
    'text-slate-700 hover:text-primary text-xs transition-colors duration-150 leading-tight block py-1',
    { 'font-bold': pathname === slug },
  ]}>Art. {number} {name}</a
>
