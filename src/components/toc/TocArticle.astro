---
interface Props {
  slug: string
  number: number
  name: string | undefined
}

const { slug, number, name } = Astro.props

const pathname = Astro.url.pathname
---

<a
  href={slug}
  class:list={[
    'text-slate-500 hover:text-primary text-sm transition-colors duration-150 leading-tight block py-1',
    { 'font-bold': pathname === slug },
  ]}
>
  Art. {number}
  {name}
</a>
