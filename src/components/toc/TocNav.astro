---
import { getTocNav } from '@/sanity/queries'
import TocAccordion from '@/components/toc/TocAccordion.astro'
import { getLocale, getLocaleUrl } from 'astro-i18n-aut'
const locale = getLocale(Astro.url) as LangKeys

//TODO: like for "On this page", find a way to not make an additionnal API call
const toc = await getTocNav()

function titleURL(number: number) {
  return getLocaleUrl(`/titel/${number}/`, locale)
}

function chapterURL(titleNumber: number, chapterNumber: number) {
  return getLocaleUrl(`/titel/${titleNumber}/kapitel/${chapterNumber}/`, locale)
}

function normalizedPath(pathname: string) {
  return pathname.replace(/\/$/, '')
}

function isCurrentChapter(titleNumber: number, chapterNumber: number) {
  return (
    normalizedPath(
      new URL(chapterURL(titleNumber, chapterNumber), Astro.url).pathname
    ) === normalizedPath(Astro.url.pathname)
  )
}

function isCurrentTitle(titleNumber: number, chapters: { number: number }[]) {
  return (
    normalizedPath(new URL(titleURL(titleNumber), Astro.url).pathname) ===
      normalizedPath(Astro.url.pathname) ||
    chapters.some((chapter) => isCurrentChapter(titleNumber, chapter.number))
  )
}
---

<aside class="fixed left-4 top-20 bottom-0 w-[320px]">
  <nav class="space-y-1 h-full overflow-y-auto scrollbar-gutter-stable">
    {
      toc.map((title) =>
        title.chapters.length > 0 ? (
          <TocAccordion
            name={title.name[locale]}
            href={titleURL(title.number)}
            isOpen={isCurrentTitle(title.number, title.chapters)}
            isActive={isCurrentTitle(title.number, title.chapters)}
            class="font-medium text-slate-600"
          >
            {title.chapters.map((chapter) => (
              <a
                href={chapterURL(title.number, chapter.number)}
                class:list={[
                  'block pl-4 py-1 text-sm transition-colors hover:text-primary',
                  isCurrentChapter(title.number, chapter.number)
                    ? 'rounded-r-sm border-l-4 border-primary bg-blue-100 pl-3 font-semibold text-primary'
                    : 'text-slate-600',
                ]}
                aria-current={
                  isCurrentChapter(title.number, chapter.number)
                    ? 'page'
                    : undefined
                }
              >
                {chapter.name[locale]}
              </a>
            ))}
          </TocAccordion>
        ) : (
          <a
            href={titleURL(title.number)}
            class:list={[
              'block px-4 py-2 font-medium text-slate-600 transition-colors hover:underline',
              isCurrentTitle(title.number, title.chapters) &&
                'border-l-2 border-primary/60 bg-blue-50 pl-3 text-primary',
            ]}
            aria-current={
              isCurrentTitle(title.number, title.chapters) ? 'page' : undefined
            }
          >
            {title.name[locale]}
          </a>
        )
      )
    }
  </nav>
</aside>
