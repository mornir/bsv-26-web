---
import { getIndex } from '@/sanity/queries'
import { buildToc } from '@/utils/helpers'
import { formatHeading } from '@/i18n/utils'
import TocAccordion from '@/components/toc/TocAccordion.astro'
import { getLocale, getLocaleUrl } from 'astro-i18n-aut'
const locale = getLocale(Astro.url) as LangKeys
const index = await getIndex()

const toc = buildToc(index)

function titleURL(number: number) {
  return getLocaleUrl(`/titel/${number}/`, locale)
}

function chapterURL(titleNumber: number, chapterNumber: number) {
  return getLocaleUrl(`/titel/${titleNumber}/kapitel/${chapterNumber}/`, locale)
}
---

<aside class="sticky top-14">
  <nav class="space-y-1 h-[calc(100vh-56px)] overflow-y-auto">
    {
      toc.map((title) =>
        title.chapters.length > 0 ? (
          <TocAccordion
            name={title.name[locale]}
            href={titleURL(title.number)}
            class="font-medium text-slate-600"
          >
            {title.chapters.map((chapter) => (
              <a
                href={chapterURL(title.number, chapter.number)}
                class="block pl-4  text-sm  text-slate-600 transition-colors hover:text-primary"
              >
                {chapter.name[locale]}
              </a>
            ))}
          </TocAccordion>
        ) : (
          <a
            href={titleURL(title.number)}
            class="block px-4 py-2 font-medium text-slate-600 transition-colors hover:underline"
          >
            {title.name[locale]}
          </a>
        )
      )
    }
  </nav>
</aside>
