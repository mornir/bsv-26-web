---
import LanguagePicker from './LanguagePicker.astro'
import { useTranslations } from '@/i18n/utils'
import { getLocale } from 'astro-i18n-aut'
import Link from './Link.astro'

const locale = getLocale(Astro.url) as LangKeys

const t = useTranslations(locale)

const mainNav = [
  {
    name: t('nav.articles'),
    path: 'art',
  },
  {
    name: t('nav.titles'),
    path: 'titel',
  },
  {
    name: t('nav.appendices'),
    path: 'anhang',
  },
  { name: t('nav.faq'), path: 'faq' },
  { name: t('nav.agent'), path: 'agent' },
]
---

<header class="border-b border-slate-200 bg-white sticky top-0 z-30">
  <div
    class="mx-auto flex flex-col gap-y-4 md:flex-row items-center justify-between px-4 py-3"
  >
    <a href={`/`} class="text-xl font-bold font-serif tracking-wider">
      {t('nav.brand')}
    </a>

    <nav class="flex items-center justify-center gap-x-8">
      {mainNav.map((item) => <Link text={item.name} slug={item.path} />)}
    </nav>

    <div class="flex items-center">
      <LanguagePicker />
    </div>
  </div>
</header>
