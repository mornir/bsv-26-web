---
import { locales } from '@/i18n/ui'
import { getLocaleUrl, getLocale } from 'astro-i18n-aut'
import { useTranslations } from '@/i18n/utils'
import PagefindConfig from 'astro-pagefind/components/PagefindConfig.astro'
import ArticleJump from './ArticleJump.astro'
import Logo from './vkf-black.svg'
import { MessagesSquare } from '@lucide/astro'

import Link from './Link.astro'

const locale = getLocale(Astro.url) as LangKeys

const t = useTranslations(locale)

const mainNav = [
  {
    name: 'Übersicht',
    path: '',
  },
  {
    name: 'Artikelverzeichnis',
    path: 'art',
  },
  { name: t('nav.faq'), path: 'anfragen' },
  {
    name: 'Nutzergruppen',
    path: 'nutzergruppen',
  },
]
---

<header class="border-b border-slate-200 bg-white sticky top-0 z-30">
  <div class="grid grid-cols-3 gap-y-4 px-6 py-2 items-center">
    <a
      href={`/`}
      class="flex items-center gap-2 text-xl font-bold tracking-wider"
    >
      <Logo class="h-7 w-auto" />
      {t('nav.brand')}
    </a>

    <nav class="flex gap-8 text-sm justify-self-center">
      {mainNav.map((item) => <Link text={item.name} slug={item.path} />)}
    </nav>

    <div class="flex items-center gap-x-6 justify-self-end">
      <nav class="flex gap-4 font-headline text-xs font-bold">
        {
          Object.entries(locales).map(([lang]) => (
            <a
              class:list={[
                { 'text-primary border-b-2 border-primary': locale === lang },
                {
                  'text-outline hover:text-primary transition-colors':
                    locale !== lang,
                },
              ]}
              href={getLocaleUrl(Astro.url, lang)}
            >
              {lang.toUpperCase()}
            </a>
          ))
        }
      </nav>
      <div class="flex gap-x-4">
        <div class="w-27 h-9">
          <PagefindConfig />
          <pagefind-modal-trigger compact></pagefind-modal-trigger>
          <pagefind-modal></pagefind-modal>
        </div>
        <ArticleJump />
      </div>

      <button
        type="button"
        @click="chatOpen = !chatOpen"
        aria-label="Chat öffnen"
        aria-controls="sidebar-chat"
        :aria-expanded="chatOpen"
        class="flex items-center gap-1 text-white hover:bg-accent transition-colors px-3 h-9 rounded cursor-pointer bg-neutral text-sm"
      >
        <MessagesSquare class="size-4" />
        <span>KI&nbsp;fragen</span>
      </button>
    </div>
  </div>
</header>
