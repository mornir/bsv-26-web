---
import type { Article } from '@/types/sanity.types'

interface Props {
  articles?: Article[]
  title?: string
}

const { articles = [], title = 'Auf dieser Seite' } = Astro.props
---

<aside class="sticky top-24 h-fit">
  <p class="text-lg font-semibold mb-2">{title}</p>
  <nav class="flex flex-col gap-y-3">
    {
      articles.map((article) => (
        <a href="#" class="text-sm">
          Art.{article.number} {article.name.de}
        </a>
      ))
    }
  </nav>
</aside>
