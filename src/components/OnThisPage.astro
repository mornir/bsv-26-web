---
const { articles = [] } = Astro.props
---

<aside class="sticky top-24 h-fit">
  <p class="text-lg font-semibold mb-2">Auf dieser Seite</p>
  <nav class="flex flex-col gap-y-3 max-w-xs">
    {
      articles.map((article) => (
        <a href="#" class="text-sm">
          Art.{article.number} {article.name.de}
        </a>
      ))
    }
  </nav>
</aside>
