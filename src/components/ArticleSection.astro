---
import ArticleListItem from '@/components/ArticleListItem.astro'
import { formatHeading } from '@/i18n/utils'

interface Props {
  articles: Array<any>
  locale: LangKeys
  section?: {
    number: number | string
    name: Partial<Record<LangKeys, string>>
  }
  articleHeadingLevel?: 'h2' | 'h3'
}

const { articles, locale, section, articleHeadingLevel = 'h2' } = Astro.props
---

{
  section ? (
    <div>
      <div class="section-heading sticky top-22 z-20 mt-12">
        <h2
          class="section-heading__label border-y border-slate-200 bg-white/95 py-3 text-center text-xl font-semibold backdrop-blur scroll-mt-24"
          id={`abs-${section.number}`}
        >
          {formatHeading({ number: section.number, type: 'section' }, locale)}:{' '}
          {section.name.de}
        </h2>
      </div>

      <div class="space-y-8 mt-8" data-pagefind-ignore>
        {articles.map((article) => (
          <ArticleListItem
            name={article.name[locale] ?? ''}
            number={article.number}
            law={article.law[locale]}
            exp={article.exp?.[locale]}
            headingLevel={articleHeadingLevel}
          />
        ))}
      </div>
    </div>
  ) : (
    <div class="space-y-8" data-pagefind-ignore>
      {articles.map((article) => (
        <ArticleListItem
          name={article.name[locale] ?? ''}
          number={article.number}
          law={article.law[locale]}
          exp={article.exp?.[locale]}
          headingLevel={articleHeadingLevel}
        />
      ))}
    </div>
  )
}

<style>
  .section-heading {
    container-type: scroll-state;
  }

  .section-heading__label {
    transition:
      font-size 150ms ease,
      line-height 150ms ease,
      padding 150ms ease;
  }

  /* Compact the section label only while its sticky container is pinned. */
  @container scroll-state(stuck: top) {
    .section-heading__label {
      font-size: 0.875rem;
      line-height: 1.25rem;
      padding-block: 0.375rem;
    }
  }
</style>
