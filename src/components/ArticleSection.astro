---
import ArticleListItem from '@/components/ArticleListItem.astro'
import { formatHeading } from '@/i18n/utils'

interface Props {
  articles: Array<any>
  locale: LangKeys
  section?: {
    number: number | string
    name: Partial<Record<LangKeys, string>>
  }
  articleHeadingLevel?: 'h2' | 'h3'
}

const { articles, locale, section, articleHeadingLevel = 'h2' } = Astro.props
const sectionLabel = section
  ? `${formatHeading({ number: section.number, type: 'section' }, locale)}: ${section.name[locale] ?? section.name.de}`
  : ''
---

{
  section ? (
    <div
      x-intersect:enter={`setActiveSection(${JSON.stringify(sectionLabel)})`}
    >
      <h2
        class="font-semibold text-center scroll-mt-24 text-xl mt-12"
        id={`abs-${section.number}`}
      >
        {sectionLabel}
      </h2>

      <div class="space-y-8 mt-8" data-pagefind-ignore>
        {articles.map((article) => (
          <ArticleListItem
            name={article.name[locale] ?? ''}
            number={article.number}
            law={article.law[locale]}
            exp={article.exp?.[locale]}
            headingLevel={articleHeadingLevel}
          />
        ))}
      </div>
    </div>
  ) : (
    <div class="space-y-8" data-pagefind-ignore>
      {articles.map((article) => (
        <ArticleListItem
          name={article.name[locale] ?? ''}
          number={article.number}
          law={article.law[locale]}
          exp={article.exp?.[locale]}
          headingLevel={articleHeadingLevel}
        />
      ))}
    </div>
  )
}
