---
import RichText from '@/components/portable-text/RichText.astro'
import type { ArticleView } from '@/pages/art/[number].astro'

interface Props {
  article: ArticleView
}

const { number, law, exp = null, name } = Astro.props.article
---

<article class="mx-auto mt-4 max-w-3xl p-12 font-serif text-law">
  <header class="mb-6">
    <div class="mb-1 font-mono text-slate-600">Artikel {number}</div>
    <h1 class="text-3xl leading-tight">{name}</h1>
  </header>
  <!-- Vorschriftentext -->
  <RichText blocks={law} />

  <!-- Erläuterung -->
  {
    exp && (
      <div class="mt-8 w-fit border-l-4 border-[#49636f] bg-[#cdedfe] p-6">
        <h2 class="font-sans font-bold uppercase tracking-widest text-secondary">
          Erläuterung zum Art. {number}
        </h2>
        <div class="mt-8">
          <RichText blocks={exp} />
        </div>
      </div>
    )
  }
</article>
