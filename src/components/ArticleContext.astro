---
interface Props {
  title: {
    heading: string
    name: string
  }
  chapter?: {
    heading: string
    name: string
  }
}

const { title, chapter } = Astro.props
---

<div
  class="sticky top-16 z-30 mb-6 w-full border-b border-slate-200 bg-white/95 px-4 py-2 text-[10px] font-medium uppercase tracking-[0.14em] text-slate-500 shadow-[0_8px_18px_-16px_rgba(15,23,42,0.5)] backdrop-blur-md"
>
  <nav
    class="flex min-w-0 items-center justify-center gap-2 overflow-x-auto whitespace-nowrap"
  >
    <span class="font-semibold text-primary">
      {title.heading}: {title.name}
    </span>
    {
      chapter && (
        <>
          <span class="text-slate-400" aria-hidden="true">
            /
          </span>
          <span class="text-slate-600">
            {chapter.heading}: {chapter.name}
          </span>
        </>
      )
    }
  </nav>
</div>
