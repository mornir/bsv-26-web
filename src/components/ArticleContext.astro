---
interface Props {
  title: {
    heading: string
    name: string
  }
  chapter?: {
    heading: string
    name: string
  }
}

const { title, chapter } = Astro.props
---

<div
  class="sticky top-14 z-20 -mx-4 border-y border-slate-200 bg-white/95 px-4 py-2 text-xs backdrop-blur"
>
  <nav
    class="flex min-w-0 items-center gap-2 overflow-x-auto whitespace-nowrap justify-center"
  >
    <span class="font-semibold text-primary">
      {title.heading}: {title.name}
    </span>
    {
      chapter && (
        <>
          <span class="text-slate-400" aria-hidden="true">
            /
          </span>
          <span>
            {chapter.heading}: {chapter.name}
          </span>
        </>
      )
    }
  </nav>
</div>
