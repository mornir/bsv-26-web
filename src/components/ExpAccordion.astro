---
import { ChevronDown, ChevronRight } from '@lucide/astro'

interface Props {
  number: number
}

const { number } = Astro.props
---

<div x-data="{ expanded: false }" role="region">
  <h3>
    <button
      type="button"
      x-on:click="expanded = !expanded"
      :aria-expanded="expanded"
      class="flex w-full items-center gap-2 bg-slate-50/50 px-4 py-3 text-left font-medium text-secondary transition-colors border-l-2 border-l-primary cursor-pointer justify-between"
    >
      <span
        class="font-sans font-bold uppercase tracking-widest text-secondary text-xs"
        >Erläuterung zu Art. {number}</span
      >

      <ChevronDown x-show="expanded" class="h-5 w-5" />

      <ChevronRight x-show="!expanded" class="h-5 w-5" />
    </button>
  </h3>

  <div
    x-show="expanded"
    x-collapse
    class="border-l-2 bg-slate-50/50 border-l-primary"
  >
    <div class="p-4 leading-relaxed">
      <slot />
    </div>
  </div>
</div>
