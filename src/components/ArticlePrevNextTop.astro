---
import { ArrowLeft, ArrowRight } from '@lucide/astro'
import { getLocale, getLocaleUrl } from 'astro-i18n-aut'
import { useTranslations } from '@/i18n/utils'

interface AdjacentArticle {
  number: number
  name: Partial<Record<LangKeys, string>>
}

interface Props {
  previousArticle?: AdjacentArticle | null
  nextArticle?: AdjacentArticle | null
}

const { previousArticle = null, nextArticle = null } = Astro.props
const locale = getLocale(Astro.url) as LangKeys
const t = useTranslations(locale)
---

<nav class="flex items-center gap-2">
  {
    previousArticle && (
      <a
        class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold text-slate-600 hover:text-primary hover:bg-slate-50 border border-slate-200 rounded-sm transition-all group"
        href={getLocaleUrl(`/art/${previousArticle.number}`, locale)}
        title={`${t('nav.prev')}: Art. ${previousArticle.number} ${previousArticle.name[locale]}`}
      >
        <ArrowLeft class="size-4 group-hover:-translate-x-0.5 transition-transform" />
        <span class="tabular-nums">Art. {previousArticle.number}</span>
      </a>
    )
  }
  {
    nextArticle && (
      <a
        class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold text-slate-600 hover:text-primary hover:bg-slate-50 border border-slate-200 rounded-sm transition-all group"
        href={getLocaleUrl(`/art/${nextArticle.number}`, locale)}
        title={`${t('nav.next')}: Art. ${nextArticle.number} ${nextArticle.name[locale]}`}
      >
        <span class="tabular-nums">Art. {nextArticle.number}</span>
        <ArrowRight class="size-4 group-hover:translate-x-0.5 transition-transform" />
      </a>
    )
  }
</nav>
