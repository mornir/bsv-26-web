---
import PageIndex from '@/layouts/PageIndex.astro'
import { getUsersGroups } from '@/sanity/queries'

const usersGroup = await getUsersGroups()

const riskLevels = [
  { title: 'Niedrige', value: 'low' },
  { title: 'Mittlere', value: 'moderate' },
  { title: 'Erhöhte', value: 'elevated' },
  { title: 'Hohe', value: 'high' },
  { title: 'Sehr hohe', value: 'very_high' },
]
---

<PageIndex title="Nutzergruppen">
  <p class="text-right text-xs italic">
    Zusammenstellung aus <a href="/art/50/" class="underline">Art. 50</a>
  </p>
  <div class="flex flex-col gap-y-8 mt-2">
    {
      usersGroup.map((group) => {
        const { title, value } = riskLevels.find(
          (r) => r.value === group.riskLevel
        )

        return (
          <div class="bg-white px-6 py-8">
            <div class="flex justify-between items-center">
              <h2 class="font-bold text-xl">Gruppe {group.designation}</h2>

              <span
                class:list={[
                  'font-semibold',
                  { 'text-red-500': value === 'very_high' },
                  { 'text-orange-500': value === 'high' },
                  { 'text-amber-500': value === 'elevated' },
                  { 'text-yellow-500': value === 'moderate' },
                  { 'text-lime-500': value === 'low' },
                ]}
              >
                {title} Gefährdung
              </span>
            </div>
            <p class="mt-4">
              <span class="font-semibold">Beispiele:</span> <br />
              {group.examples.de}
            </p>

            <p class="mt-4">
              <span class="font-semibold">Beschreibung:</span> <br />{' '}
              {group.desc.de}
            </p>
          </div>
        )
      })
    }
  </div>
</PageIndex>
