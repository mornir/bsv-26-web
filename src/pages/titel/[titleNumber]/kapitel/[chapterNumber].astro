---
import ArticleList from '@/layouts/ArticleList.astro'
import { getChapters } from '@/sanity/queries'
import { getLocale } from 'astro-i18n-aut'
import { formatHeading } from '@/i18n/utils'
import OnThisPage from '@/components/OnThisPage.astro'
import ArticleSection from '@/components/ArticleSection.astro'

const locale = getLocale(Astro.url) as LangKeys

export async function getStaticPaths() {
  const chapters = await getChapters()
  return chapters.map((chapter) => ({
    params: {
      titleNumber: chapter.title.slug,
      chapterNumber: chapter.number.toString(),
    },
    props: {
      articles: chapter.articles,
      sections: chapter.sections,
      chapter: {
        number: chapter.number,
        name: chapter.name,
      },
    },
  }))
}

const { articles, chapter, sections } = Astro.props

const heading = formatHeading(
  { number: chapter.number, type: 'chapter' },
  locale
)
const pageTitle = `${heading}: ${chapter?.name[locale]}`
---

<ArticleList title={pageTitle} tabTitel={heading}>
  <OnThisPage slot="toc" articles={articles} title="In diesem Kapitel" />

  {
    sections.length === 0 ? (
      <ArticleSection
        articles={articles}
        locale={locale}
        articleHeadingLevel="h2"
      />
    ) : (
      sections.map((section) => (
        <ArticleSection
          articles={section.articles}
          locale={locale}
          section={section}
          articleHeadingLevel="h3"
        />
      ))
    )
  }
</ArticleList>
