---
import ArticleList from '@/layouts/ArticleList.astro'
import { getChapters } from '@/sanity/queries'
import { getLocale } from 'astro-i18n-aut'
import { formatHeading } from '@/i18n/utils'
import OnThisPage from '@/components/OnThisPage.astro'
import ArticleSection from '@/components/ArticleSection.astro'
import ArticleContext from '@/components/ArticleContext.astro'

const locale = getLocale(Astro.url) as LangKeys

export async function getStaticPaths() {
  const chapters = await getChapters()
  return chapters.map((chapter) => ({
    params: {
      titleNumber: chapter.title.slug,
      chapterNumber: chapter.number.toString(),
    },
    props: {
      articles: chapter.articles,
      sections: chapter.sections,
      chapter: {
        number: chapter.number,
        name: chapter.name,
      },
      title: chapter.title,
    },
  }))
}

const { articles, chapter, sections, title } = Astro.props

const chapterHeading = formatHeading(
  { number: chapter.number, type: 'chapter' },
  locale
)
const titleHeading = formatHeading(
  { number: title.number, type: 'title' },
  locale
)

const chapterName = chapter.name[locale] ?? chapter.name.de
const pageTitle = `${chapterHeading}: ${chapterName}`
---

<ArticleList title={pageTitle} tabTitel={chapterName}>
  <OnThisPage
    slot="on-this-page"
    articles={articles}
    title="In diesem Kapitel"
  />

  <ArticleContext
    slot="context"
    title={{
      heading: titleHeading,
      name: title.name[locale] ?? title.name.de,
    }}
    chapter={{
      heading: chapterHeading,
      name: chapterName,
    }}
  />

  {
    sections.length === 0 ? (
      <ArticleSection
        articles={articles}
        locale={locale}
        articleHeadingLevel="h2"
      />
    ) : (
      sections.map((section) => (
        <ArticleSection
          articles={section.articles}
          locale={locale}
          section={section}
          articleHeadingLevel="h3"
        />
      ))
    )
  }
</ArticleList>
