---
import ArticleList from '@/layouts/ArticleList.astro'
import { getTitles } from '@/sanity/queries'
import { formatHeading } from '@/i18n/utils'
import { getLocale } from 'astro-i18n-aut'
import OnThisPage from '@/components/OnThisPage.astro'
import ArticleSection from '@/components/ArticleSection.astro'

const locale = getLocale(Astro.url) as LangKeys

export async function getStaticPaths() {
  const titles = await getTitles()
  return titles.map((title) => ({
    params: { titleNumber: title.slug.current },
    props: {
      chapters: title.chapters,
      articles: title.articles,
      sections: title.sections,
      title: {
        number: title.number,
        name: title.name,
      },
    },
  }))
}

const { chapters, articles, title, sections } = Astro.props

const heading = formatHeading({ number: title.number, type: 'title' }, locale)
const pageTitle = `${heading}: ${title?.name[locale]}`
---

<ArticleList
  title={pageTitle}
  tabTitel={heading}
  titleContext={{ heading, name: title.name[locale] ?? title.name.de }}
>
  <OnThisPage slot="on-this-page" articles={articles} title="In diesem Titel" />

  {
    sections.length === 0 ? (
      <ArticleSection
        articles={articles}
        locale={locale}
        articleHeadingLevel="h2"
      />
    ) : (
      sections.map((section) => (
        <ArticleSection
          articles={section.articles}
          locale={locale}
          section={section}
          articleHeadingLevel="h3"
        />
      ))
    )
  }

  {
    chapters.length > 0 && (
      <ol class="mt-8 grid gap-4 sm:grid-cols-2">
        {chapters.map((chapter) => (
          <li class="border border-slate-300 bg-white transition-colors hover:border-slate-500">
            <a
              href={`/titel/${title.number}/kapitel/${chapter.number}/`}
              class="block p-5"
            >
              <span class="block font-mono text-sm text-slate-600">
                {formatHeading(
                  { number: chapter.number, type: 'chapter' },
                  locale
                )}
              </span>
              <span class="mt-1 block text-lg font-semibold">
                {chapter.name[locale]}
              </span>
            </a>
          </li>
        ))}
      </ol>
    )
  }
</ArticleList>
