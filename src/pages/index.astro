---
import PageIndex from '@/layouts/PageIndex.astro'
import Layout from '@/layouts/Layout.astro'

import { useTranslations, formatHeading } from '@/i18n/utils'
import { getLocale } from 'astro-i18n-aut'
import { getUnits } from '@/sanity/queries'

const locale = getLocale(Astro.url) as LangKeys

const t = useTranslations(locale)

const units = await getUnits()
---

<Layout title="Übersicht">
  <main class="pt-12 pb-32 bg-slate-50">
    <section
      class="grid grid-cols-3 gap-6 justify-center p-8 max-w-7xl mx-auto"
    >
      {
        units.map((unit) => {
          if (unit.chapters.length > 0) {
            return (
              <div
                class:list={[
                  'border p-6 border-slate-300 rounded-lg bg-white',
                  {
                    'col-span-3': [3, 4, 5, 8].includes(unit.number),
                    'col-span-2': [7, 9].includes(unit.number),
                  },
                ]}
              >
                <h2 class="text-xl font-bold mb-4">
                  <a
                    href={`/titel/${unit.number}/`}
                    class="transition-colors hover:text-slate-600 hover:underline"
                  >
                    {formatHeading(
                      { number: unit.number, type: 'title' },
                      locale
                    )}
                  </a>
                  <a
                    href={`/titel/${unit.number}/`}
                    class="transition-colors hover:text-slate-600 hover:underline"
                  >
                    {unit.title}
                  </a>
                </h2>

                <ol class="grid gap-3 grid-cols-3 mt-2">
                  {unit.chapters.map((chapter) => (
                    <li>
                      <a
                        href={`/titel/${unit.number}/kapitel/${chapter.number}/`}
                        class="cursor-pointer border border-slate-300 bg-white p-4 transition-colors hover:border-slate-500 block font-semibold h-full rounded-md"
                      >
                        <span class="block text-xs uppercase font-mono text-slate-500 group-hover:text-blue-700">
                          {formatHeading(
                            { number: chapter.number, type: 'chapter' },
                            locale
                          )}
                        </span>
                        <span class="mt-1 block text-sm font-semibold text-balance">
                          {chapter.name[locale]}
                        </span>

                        <div class="mt-3 text-xxs font-mono text-slate-400 pt-2 border-t border-slate-100">
                          Art. 301 – 312
                        </div>
                      </a>
                    </li>
                  ))}
                </ol>
              </div>
            )
          }
          return (
            <a
              class:list={[
                'cursor-pointer border border-slate-300 bg-white px-6 py-4 transition-colors hover:border-slate-500 rounded-lg',
                {
                  'col-span-2': [2].includes(unit.number),
                },
              ]}
              href={`/titel/${unit.number}/`}
            >
              <div class="flex justify-between">
                <span>
                  {formatHeading(
                    { number: unit.number, type: 'title' },
                    locale
                  )}
                </span>
                <span class="text-xs font-semibold font-mono text-slate-400 ">
                  Art. 301 – 312
                </span>
              </div>
              <h2 class="text-xl font-bold mt-2">{unit.title}</h2>
              <p class="mt-2 text-outline">{unit?.description}</p>
            </a>
          )
        })
      }
    </section>

    <section class="mt-12">
      <h2 class="font-semibold">Weitere Links</h2>
      <ul class="space-y-2 mt-4">
        <li><a href="/art/" class="underline">Artikelverzeichnis</a></li>
        <li><a href="/titel/" class="underline">Titel-Übersicht</a></li>
        <li><a href="#" class="underline">Model Code</a></li>
        <li><a href="#" class="underline">Abbildungen</a></li>
        <li><a href="#" class="underline">Ingress</a></li>
      </ul>
    </section>
  </main>
</Layout>
