---
import PageIndex from '@/layouts/PageIndex.astro'

import { useTranslations, formatHeading } from '@/i18n/utils'
import { getLocale } from 'astro-i18n-aut'
import { getUnits } from '@/sanity/queries'

const locale = getLocale(Astro.url) as LangKeys

const t = useTranslations(locale)

const units = await getUnits()
---

<PageIndex tabTitel="Startseite" title={t('home.title')}>
  <div class="grid justify-center gap-y-8">
    {
      units.map((unit) => {
        if (unit.chapters.length > 0) {
          return (
            <div class="border px-6 py-4 border-slate-300">
              <h2 class="text-xl font-semibold mb-4 grid grid-cols-[1fr_3fr_1fr]">
                <span>
                  {formatHeading(
                    { number: unit.number, type: 'title' },
                    locale
                  )}
                </span>
                <span class="justify-self-center">{unit.title}</span>
              </h2>

              <ol class="flex gap-3 flex-wrap mt-2">
                {unit.chapters.map((chapter) => (
                  <li>
                    <a
                      href={`/titel/${unit.number}/kapitel/${chapter.number}/`}
                      class="cursor-pointer border border-slate-300 bg-white px-4 py-2 transition-colors hover:border-slate-500 block"
                    >
                      {chapter.name.de}
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          )
        }
        return (
          <a
            class="cursor-pointer border border-slate-300 bg-white px-6 py-4 transition-colors hover:border-slate-500"
            href={`/titel/${unit.number}/`}
          >
            <h2 class="text-xl font-semibold grid grid-cols-[1fr_2fr_1fr]">
              <span>
                {formatHeading({ number: unit.number, type: 'title' }, locale)}
              </span>

              <span class="justify-self-center">{unit.title}</span>
            </h2>
          </a>
        )
      })
    }
  </div>

  <div class="mt-12">
    <h2 class="font-semibold">Weitere Links</h2>
    <ul class="space-y-2 mt-4">
      <li><a href="/art/" class="underline">Artikelverzeichnis</a></li>
      <li><a href="/titel/" class="underline">Titel-Übersicht</a></li>
      <li><a href="#" class="underline">Model Code</a></li>
      <li><a href="#" class="underline">Abbildungen</a></li>
      <li><a href="#" class="underline">Ingress</a></li>
    </ul>
  </div>
</PageIndex>
