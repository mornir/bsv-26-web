---
import Layout from '@/layouts/Layout.astro'

import { useTranslations, formatHeading } from '@/i18n/utils'
import { getLocale } from 'astro-i18n-aut'
import { getUnits } from '@/sanity/queries'

const locale = getLocale(Astro.url) as LangKeys

const t = useTranslations(locale)

const units = await getUnits()
---

<Layout title="Übersicht">
  <main class="pb-32 bg-slate-50">
    <section class="c-gradient h-[60vh] pt-28">
      <div class="max-w-7xl mx-auto px-8">
        <h1 class="text-5xl font-bold text-white">
          Schweizerische Brandschutzvorschriften
        </h1>

        <p class="text-slate-50 text-xl mt-6 max-w-3xl">
          Die schweizweit gültigen Brandschutzvorschriften der VKF stellen die
          gesetzliche Grundlage für die Ausführung des Brandschutzes in Gebäuden
          dar.
        </p>
        <p class="text-slate-50 text-xl mt-4 max-w-3xl">
          Sie wurden durch das Interkantonale Organ Technische Handelshemmnisse
          IOTH als verbindlich erklärt und in Kraft gesetzt.
        </p>
      </div>
    </section>
    <section
      class="grid grid-cols-3 gap-6 justify-center max-w-7xl p-8 mx-auto"
    >
      {
        units.map((unit) => {
          if (unit.chapters.length > 0) {
            return (
              <div
                class:list={[
                  'border p-6 border-slate-300 rounded-md bg-white',
                  {
                    'col-span-3': [3, 4, 5, 8].includes(unit.number),
                    'col-span-2': [7, 9].includes(unit.number),
                  },
                ]}
              >
                <div class="flex justify-between items-start">
                  <div class="flex items-center gap-x-4 mb-4 ">
                    <span class="rounded-sm border border-sky-200 bg-sky-50 px-2.5 py-1 text-xs font-semibold uppercase tracking-widest text-sky-700">
                      {formatHeading(
                        { number: unit.number, type: 'title' },
                        locale
                      )}
                    </span>
                    <div>
                      <h2 class="text-xl font-bold">{unit.title}</h2>
                      <p class="text-slate-500">{unit.description}</p>
                    </div>
                  </div>
                  <span class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-xxs font-semibold uppercase tracking-widest text-slate-600">
                    {unit.chapters.length} Kapitel
                  </span>
                </div>

                <ol
                  class={`grid gap-3 mt-2 ${[7].includes(unit.number) ? 'grid-cols-2' : 'grid-cols-3'}`}
                >
                  {unit.chapters.map((chapter) => (
                    <li>
                      <a
                        href={`/titel/${unit.number}/kapitel/${chapter.number}/`}
                        class="cursor-pointer border border-slate-300 bg-white p-4 transition-colors hover:border-slate-500 block h-full rounded-sm font-semibold"
                      >
                        <div class="flex justify-between items-center">
                          <span class="text-xs uppercase font-mono text-slate-500">
                            {formatHeading(
                              { number: chapter.number, type: 'chapter' },
                              locale
                            )}
                          </span>
                          <span class="rounded-full text-xxs font-semibold uppercase tracking-widest text-slate-500">
                            Art. {chapter.startArt} – {chapter.endArt}
                          </span>
                        </div>
                        <h3 class="mt-2 text-sm font-semibold text-balance">
                          {chapter.name[locale]}
                        </h3>
                      </a>
                    </li>
                  ))}
                </ol>
              </div>
            )
          }
          return (
            <a
              class:list={[
                'cursor-pointer border border-slate-300 bg-white px-6 py-4 transition-colors hover:border-slate-500 rounded-md',
                {
                  'col-span-2': [2].includes(unit.number),
                },
              ]}
              href={`/titel/${unit.number}/`}
            >
              <div class="flex justify-between items-baseline">
                <span class=" rounded-sm border border-sky-200 bg-sky-50 px-2.5 py-1 text-xs font-semibold uppercase tracking-widest text-sky-700">
                  {formatHeading(
                    { number: unit.number, type: 'title' },
                    locale
                  )}
                </span>
                <span class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-xxs font-semibold uppercase tracking-widest text-slate-600">
                  Art. {unit.startArt} – {unit.endArt}
                </span>
              </div>
              <h2 class="text-xl font-bold mt-4">{unit.title}</h2>
              <p class="mt-2 text-slate-500">{unit?.description}</p>
            </a>
          )
        })
      }
    </section>

    <section class="mt-12">
      <h2 class="font-semibold">Weitere Links</h2>
      <ul class="space-y-2 mt-4">
        <li><a href="/art/" class="underline">Artikelverzeichnis</a></li>
        <li><a href="/titel/" class="underline">Titel-Übersicht</a></li>
        <li><a href="#" class="underline">Model Code</a></li>
        <li><a href="#" class="underline">Abbildungen</a></li>
        <li><a href="#" class="underline">Ingress</a></li>
      </ul>
    </section>
  </main>
</Layout>

<style>
  .c-gradient {
    background:
      url('/vkf-short.svg') 97% 90% / auto 10% no-repeat,
      url('/flame.png') right bottom / auto 90% no-repeat,
      linear-gradient(
        to bottom,
        #050647 0%,
        #3e0d45 30%,
        #69143b 60%,
        #801735 100%
      );
  }
</style>
