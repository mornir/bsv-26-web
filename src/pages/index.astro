---
import Layout from '@/layouts/Layout.astro'

import { useTranslations } from '@/i18n/utils'
import { getLocale } from 'astro-i18n-aut'

const locale = getLocale(Astro.url) as LangKeys

const t = useTranslations(locale)
---

<Layout title="Startseite">
  <div class="-mt-16 grid place-content-center">
    <h1
      class="mx-auto mb-14 block max-w-3xl font-serif text-center text-5xl/16 font-semibold text-balance"
    >
      {t('home.title')}
    </h1>
  </div>
</Layout>
