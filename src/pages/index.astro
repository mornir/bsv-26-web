---
import Layout from '@/layouts/Layout.astro'
import Infographic from '@/components/Infographic.astro'
import { useTranslations, formatHeading } from '@/i18n/utils'
import { getLocale } from 'astro-i18n-aut'
import { getUnits } from '@/sanity/queries'
import { Scale, MessagesSquare, BookCheck } from '@lucide/astro'

const locale = getLocale(Astro.url) as LangKeys
const t = useTranslations(locale)

const units = await getUnits()

const totalInquiries = 24

const getChapterOverlayOpacity = (lightness: number | null) => {
  const normalizedLightness = lightness ?? 0.5
  return Math.min(0.3, Math.max(0.12, 0.3 - normalizedLightness * 0.28))
}

const infographics = [
  {
    number: 725,
    name: 'verbindliche\n Artikel',
    link: { name: 'Zum Artikelverzeichnis', href: '/art/' },
    icon: Scale,
  },
  {
    number: totalInquiries,
    name: 'beantwortete\n Anfragen',
    link: { name: 'Zu den Anfragen', href: '/anfragen/' },
    icon: MessagesSquare,
  },
  {
    number: 11,
    name: 'anerkannte\n Regelwerke Dritter',
    link: { name: 'Zur Liste', href: '/anfragen/' },
    icon: BookCheck,
  },
]
---

<Layout title="Übersicht">
  <main class="pb-32 bg-slate-50">
    <section class="c-gradient relative min-h-[60vh] pt-18">
      <div class="max-w-7xl mx-auto px-8">
        <h1 class="text-5xl font-bold text-white">
          Schweizerische Brandschutzvorschriften
        </h1>

        <p class="text-slate-50 text-xl mt-6 max-w-3xl">
          Die schweizweit gültigen Brandschutzvorschriften der VKF stellen die
          gesetzliche Grundlage für die Ausführung des Brandschutzes in Gebäuden
          dar.
        </p>
        <p class="text-slate-50 text-xl mt-4 max-w-3xl">
          Sie wurden durch das Interkantonale Organ Technische Handelshemmnisse
          IOTH als verbindlich erklärt und in Kraft gesetzt.
        </p>

        <div class="mt-8 flex flex-col gap-4 md:flex-row">
          {infographics.map((infographic) => <Infographic {...infographic} />)}
        </div>
      </div>
    </section>
    <section class="max-w-7xl p-8 mx-auto mt-8">
      <h2
        class="text-3xl md:text-4xl font-bold text-primary tracking-tight border-b border-slate-300 pb-4"
      >
        Die 10 Titel der Brandschutzvorschriften (BSV)
      </h2>

      <div class="grid grid-cols-3 gap-6 justify-center mt-8">
        {
          units.map((unit) => {
            if (unit.chapters.length > 0) {
              return (
                <div
                  style={{ backgroundColor: unit.color.hex }}
                  class:list={[
                    'border p-6 border-slate-300 rounded-md bg-neutral',
                    {
                      'col-span-3': [3, 4, 5, 8].includes(unit.number),
                      'col-span-2': [7, 9].includes(unit.number),
                    },
                  ]}
                >
                  <div class="flex justify-between items-start">
                    <div class="flex items-center gap-x-4 mb-4 ">
                      <span class="rounded-sm  bg-neutral px-3 py-2 text-xs font-semibold uppercase tracking-widest text-white">
                        {formatHeading(
                          { number: unit.number, type: 'title' },
                          locale
                        )}
                      </span>
                      <div>
                        <h3 class="text-xl font-bold text-white">
                          {unit.title}
                        </h3>
                        <p class="text-slate-50">{unit.description}</p>
                      </div>
                    </div>
                    <span class="rounded-full border  border-slate-200 bg-slate-50 px-2.5 py-1 text-xxs font-semibold uppercase tracking-widest">
                      {unit.chapters.length} Kapitel
                    </span>
                  </div>

                  <ol
                    class={`grid gap-3 mt-2 ${[7].includes(unit.number) ? 'grid-cols-2' : 'grid-cols-3'}`}
                  >
                    {unit.chapters.map((chapter) => (
                      <li>
                        <a
                          href={`/titel/${unit.number}/kapitel/${chapter.number}/`}
                          class="cursor-pointer border border-white/10 p-4 transition-colors block h-full rounded-sm font-semibold backdrop-blur-sm"
                          style={{
                            backgroundColor: `rgb(255 255 255 / ${getChapterOverlayOpacity(unit.color.lightness)})`,
                          }}
                        >
                          <div class="flex justify-between items-center text-slate-50">
                            <span class="text-xs uppercase font-mono ">
                              {formatHeading(
                                { number: chapter.number, type: 'chapter' },
                                locale
                              )}
                            </span>
                            <span class="rounded-full text-xxs font-semibold uppercase tracking-widest">
                              Art. {chapter.startArt} – {chapter.endArt}
                            </span>
                          </div>
                          <h4 class="mt-2 text-sm font-semibold text-balance text-white">
                            {chapter.name[locale]}
                          </h4>
                        </a>
                      </li>
                    ))}
                  </ol>
                </div>
              )
            }
            return (
              <a
                style={{ backgroundColor: unit.color.hex }}
                class:list={[
                  'cursor-pointer border border-slate-300  px-6 py-4 transition-colors hover:border-slate-500 rounded-md',
                  {
                    'col-span-2': [2].includes(unit.number),
                  },
                ]}
                href={`/titel/${unit.number}/`}
              >
                <div class="flex justify-between items-baseline">
                  <span class="rounded-sm  bg-neutral  px-2.5 py-1 text-xs font-semibold uppercase tracking-widest text-white">
                    {formatHeading(
                      { number: unit.number, type: 'title' },
                      locale
                    )}
                  </span>
                  <span class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-xxs font-semibold uppercase tracking-widest text-slate-600">
                    Art. {unit.startArt} – {unit.endArt}
                  </span>
                </div>
                <h3 class="text-xl font-bold mt-4 text-white">{unit.title}</h3>
                <p class="mt-2 text-slate-50">{unit?.description}</p>
              </a>
            )
          })
        }
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-8 mt-12">
      <h2
        class="text-2xl md:text-3xl font-bold text-primary tracking-tight border-b border-slate-300 pb-4"
      >
        Anhänge und weitere Dokumente
      </h2>
      <ul class="space-y-2 mt-4">
        <li><a href="#" class="underline">Model Code</a></li>
        <li><a href="#" class="underline">Abbildungen</a></li>
        <li><a href="#" class="underline">Ingress</a></li>
      </ul>
    </section>
  </main>
</Layout>

<style>
  .c-gradient {
    background:
      url('/vkf-short.svg') 97% 90% / auto 10% no-repeat,
      url('/flame.png') right bottom / auto 90% no-repeat,
      linear-gradient(
        to bottom,
        #050647 0%,
        #3e0d45 30%,
        #69143b 60%,
        #801735 100%
      );
  }
</style>
