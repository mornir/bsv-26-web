---
import ArticleLayout from '@/layouts/ArticleLayout.astro'
import RichText from '@/components/portable-text/RichText.astro'
import LangCompare from '@/components/LangCompare.astro'
import ArticlePrevNext from '@/components/ArticlePrevNext.astro'
import MetadataPanel from '@/components/MetadataPanel.astro'
import { getArticles, getArticle } from '@/sanity/queries'
import { getLocale, getLocaleUrl } from 'astro-i18n-aut'
import { formatHeading } from '@/i18n/utils'

const locale = getLocale(Astro.url) as LangKeys

export async function getStaticPaths() {
  const articles = await getArticles()
  return articles.map((article, index) => ({
    params: { number: article.slug.current },
    props: {
      article,
      previousArticle: articles[index - 1]
        ? {
            number: articles[index - 1].number,
            name: articles[index - 1].name,
          }
        : null,
      nextArticle: articles[index + 1]
        ? {
            number: articles[index + 1].number,
            name: articles[index + 1].name,
          }
        : null,
    },
  }))
}

let art = Astro.props.article
const previousArticle = Astro.props.previousArticle
const nextArticle = Astro.props.nextArticle

const isDev = import.meta.env.DEV
if (isDev) {
  // @ts-ignore
  art = await getArticle(Astro.params.number)
}
---

<ArticleLayout title={'Art. ' + art.number}>
  <MetadataPanel
    slot="metadata-panel"
    title={art.title}
    chapter={art.chapter}
    section={art.section}
  />

  <div x-data={`{languages: ['${locale}']}`} class="mb-24">
    <!--    <Toolbar /> -->
    <div x-show="languages.length === 1" class="max-w-3xl mx-auto p-12">
      <nav
        class="flex items-center gap-2 mb-8 text-[11px] font-medium tracking-wide uppercase text-outline"
      >
        <a class="hover:text-primary transition-colors" href="/">Startseite</a>
        <span>/</span>
        <a
          class="hover:text-primary transition-colors"
          href={getLocaleUrl(`/titel/${art.title.number}`, locale)}
        >
          {formatHeading({ number: art.title.number, type: 'title' }, locale)}
        </a>

        <span>/</span>

        {
          art?.chapter?.number && (
            <Fragment>
              <span class="text-primary">
                {formatHeading(
                  { number: art.chapter.number, type: 'chapter' },
                  locale
                )}{' '}
                &ndash; {art.chapter.name[locale]}
              </span>
              <span>/</span>
            </Fragment>
          )
        }

        {
          art?.section?.number && (
            <Fragment>
              <span class="text-primary">
                {formatHeading(
                  { number: art.section.number, type: 'section' },
                  locale
                )}{' '}
                &ndash; {art.section.name[locale]}
              </span>
              <span>/</span>
            </Fragment>
          )
        }
        <span class="text-primary">Art. {art.number}</span>
      </nav>
      <article class="mt-4 font-serif text-law">
        <header class="mb-6">
          <h2 class="mb-1 font-mono text-slate-600">
            Artikel {art.number}
          </h2>
          <h1 class="text-3xl leading-tight font-medium">
            {art.name[locale]}
          </h1>
        </header>

        <!-- Vorschriftentext -->
        <RichText blocks={art.law[locale]} />

        <!-- Erläuterung -->
        {
          art.exp?.[locale] && (
            <div class="mt-8 w-fit border-l-4 p-6 bg-slate-50/50 border border-slate-200 rounded-sm  border-l-primary">
              <h2 class="font-sans font-bold uppercase tracking-widest text-secondary">
                Erläuterung zu Art. {art.number}
              </h2>
              <div class="mt-6">
                <RichText blocks={art.exp[locale]} />
              </div>
            </div>
          )
        }

        <ArticlePrevNext {previousArticle} {nextArticle} />
      </article>
    </div>

    <!-- Sprachvergleich -->
    <template x-if="languages.length > 1" x-cloak>
      <LangCompare article={art} />
    </template>
  </div>
</ArticleLayout>
