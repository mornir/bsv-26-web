---
import ArticleLayout from '@/layouts/ArticleLayout.astro'
import RichText from '@/components/portable-text/RichText.astro'
import ArticlePrevNext from '@/components/ArticlePrevNext.astro'
import MetadataPanel from '@/components/MetadataPanel.astro'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import { getArticles, getArticle } from '@/sanity/queries'
import { getLocale } from 'astro-i18n-aut'
import { formatHeading } from '@/i18n/utils'

const locale = getLocale(Astro.url) as LangKeys

export async function getStaticPaths() {
  const articles = await getArticles()
  return articles.map((article, index) => ({
    params: { number: article.slug.current },
    props: {
      article,
      previousArticle: articles[index - 1]
        ? {
            number: articles[index - 1].number,
            name: articles[index - 1].name,
          }
        : null,
      nextArticle: articles[index + 1]
        ? {
            number: articles[index + 1].number,
            name: articles[index + 1].name,
          }
        : null,
    },
  }))
}

let art = Astro.props.article
const previousArticle = Astro.props.previousArticle
const nextArticle = Astro.props.nextArticle

const isDev = import.meta.env.DEV
if (isDev) {
  // @ts-ignore
  art = await getArticle(Astro.params.number)
}

const { title, chapter, section } = art

const hierarchy = [
  {
    heading: formatHeading({ number: title.number, type: 'title' }, locale),
    name: title.name[locale],
    link: `/titel/${title.number}/`,
  },
  chapter
    ? {
        heading: formatHeading(
          { number: chapter.number, type: 'chapter' },
          locale
        ),
        name: chapter.name[locale],
        link: `/titel/${title.number}/kapitel/${chapter.number}/`,
      }
    : null,
  section
    ? {
        heading: formatHeading(
          { number: section.number, type: 'section' },
          locale
        ),
        name: section.name[locale],
        link: '#',
      }
    : null,
].filter(Boolean) as Hierarchy
---

<ArticleLayout title={'Art. ' + art.number}>
  <MetadataPanel
    slot="metadata-panel"
    hierarchy={hierarchy}
    articleNumber={art.number}
  />

  <div class="max-w-3xl mx-auto p-12">
    <Breadcrumbs articleNumber={art.number} crumbs={hierarchy} />
    <article class="mt-4 font-serif text-law">
      <header class="mb-6">
        <h1>
          <span class="font-bold block text-2xl">
            Art. {art.number}
          </span>
          <span class="text-3xl leading-tight font-medium block">
            {art.name[locale]}
          </span>
        </h1>
      </header>

      <div data-pagefind-body>
        <!-- Vorschriftentext -->
        <RichText blocks={art.law[locale]} />

        <!-- Erläuterung -->
        {
          art.exp?.[locale] && (
            <div class="mt-8 w-fit border-l-2 p-6 bg-blue-50/50 border border-blue-100  border-l-blue-800 text-blue-800">
              <h2 class="font-sans font-bold uppercase tracking-widest text-secondary">
                Erläuterung zu Art. {art.number}
              </h2>
              <div class="mt-6 ">
                <RichText blocks={art.exp[locale]} />
              </div>
            </div>
          )
        }
      </div>
      <ArticlePrevNext {previousArticle} {nextArticle} />
    </article>
  </div>
</ArticleLayout>
