---
import Layout from '@/layouts/Layout.astro'
import LangCompare from '@/components/LangCompare.astro'
import RichText from '@/components/portable-text/RichText.astro'
import { locales } from '@/i18n/ui'
import { getArticles } from '@/sanity/queries'

export async function getStaticPaths() {
  const articles = await getArticles()
  return articles.map((article, index) => ({
    params: { number: article.slug.current },
    props: {
      article,
      previousArticle: articles[index - 1]
        ? {
            number: articles[index - 1].number,
            name: articles[index - 1].name,
          }
        : null,
      nextArticle: articles[index + 1]
        ? {
            number: articles[index + 1].number,
            name: articles[index + 1].name,
          }
        : null,
    },
  }))
}

const languages = Object.keys(locales) as LangKeys[]

let art = Astro.props.article
---

<Layout title="Sprachvergleich">
  <div x-data={`{languages: ['de', 'fr']}`}>
    <div class="max-w-7xl mx-auto p-8 border-x border-slate-300">
      <div
        class="grid gap-x-8"
        :class="languages.length === 1 ? 'grid-cols-1' : 'grid-cols-2'"
      >
        {
          languages.map((lang) => (
            // https://www.joshwcomeau.com/css/subgrid/#reserving-space-for-the-subgrid-4 -->
            <article
              x-show={`languages.includes('${lang}')`}
              class="row-span-45 grid grid-rows-subgrid"
            >
              <h2 class="font-semibold mb-2">
                Art. {art.number} {art.name[lang]}
              </h2>
              <RichText blocks={art.law[lang]} />
              <RichText blocks={art?.exp?.[lang] ?? []} />
            </article>
          ))
        }
      </div>
    </div>
  </div>
</Layout>

<style>
  /* https://docs.astro.build/en/guides/styling/#global-styles */
  /* Subgrid needs to be applied to lists for horizontal alignement to work */
  article :global(ol, ul) {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 20;
  }
</style>
