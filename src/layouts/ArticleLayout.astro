---
import Layout from '@/layouts/Layout.astro'

interface Props {
  title: string
}

const { title } = Astro.props
---

<Layout title={title}>
  <div class="grid grid-cols-[320px_1fr_320px]">
    <main class="col-start-2">
      <slot />
    </main>
    <slot name="metadata-panel" />
  </div>
</Layout>
