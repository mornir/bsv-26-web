---
import '@/styles/global.css'

import NavBar from '@/components/NavBar.astro'
import Footer from '@/components/Footer.astro'
import { Font } from 'astro:assets'
import SidebarChat from '@/components/SidebarChat.astro'

import { getLocale } from 'astro-i18n-aut'
import { locales } from '@/i18n/ui'

interface Props {
  title: string
}

const lang = getLocale(Astro.url) as LangKeys
const locale = locales[lang]

const { title } = Astro.props
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-public-sans" preload />
    <Font cssVariable="--font-newsreader" />
    <title>{title} – BSV</title>
  </head>
  <body
    x-data="{ chatOpen: false }"
    @keydown.escape.window="chatOpen = false"
    class="text-primary min-h-screen"
  >
    <div class="w-full overflow-x-clip">
      <div
        class="chat-layout-track min-h-screen w-max flex"
        x-bind:style="chatOpen ? 'transform: translateX(max(-24rem, -90vw))' : 'transform: translateX(0)'"
      >
        <div class="chat-layout-main grid min-w-0 grid-rows-[auto_1fr_auto]">
          <NavBar />
          <slot />
          <Footer />
        </div>
        <SidebarChat />
      </div>
    </div>
  </body>
</html>

<style>
  .chat-layout-track {
    transition: transform 300ms ease-in-out;
  }

  .chat-layout-main {
    flex: 0 0 100vw;
  }

  .chat-layout-sidebar {
    width: 0;
    flex: 0 0 auto;
    transition: width 300ms ease-in-out;
  }
</style>
