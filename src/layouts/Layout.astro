---
import '@/styles/global.css'

import NavBar from '@/components/NavBar.astro'
import Footer from '@/components/Footer.astro'
import { Font } from 'astro:assets'
import SidebarChat from '@/components/SidebarChat.astro'

import { getLocale } from 'astro-i18n-aut'
import { locales } from '@/i18n/ui'

interface Props {
  title: string
}

const lang = getLocale(Astro.url) as LangKeys
const locale = locales[lang]

const { title } = Astro.props
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-public-sans" preload />
    <Font cssVariable="--font-newsreader" />
    <title>{title} – BSV</title>
  </head>
  <body
    x-data="{ chatOpen: false }"
    @keydown.escape.window="chatOpen = false"
    class="text-primary min-h-screen"
  >
    <div
      class="chat-layout-track min-h-screen w-full overflow-x-clip"
      :class="{ 'chat-layout-open': chatOpen }"
    >
      <div class="grid min-w-0 grid-rows-[auto_1fr_auto]">
        <NavBar />
        <slot />
        <Footer />
      </div>
      <SidebarChat />
    </div>
  </body>
</html>

<style>
  .chat-layout-track {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 0;
    transition: grid-template-columns 300ms ease-in-out;
  }

  .chat-layout-open {
    grid-template-columns: minmax(0, 1fr) min(24rem, 90vw);
  }
</style>
