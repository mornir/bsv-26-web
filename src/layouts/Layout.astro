---
import '@/styles/global.css'

import NavBar from '@/components/NavBar.astro'
import SideNav from '@/components/sidenav/SideNav.astro'
import MetadataPanel from '@/components/MetadataPanel.astro'
import { Font } from 'astro:assets'

import { getLocale } from 'astro-i18n-aut'
import { locales } from '@/i18n/ui'

interface Props {
  title: string
}

const lang = getLocale(Astro.url) as LangKeys
const locale = locales[lang]

const { title } = Astro.props
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-public-sans" />
    <Font cssVariable="--font-newsreader" />
    <title>{title} – BSV 2026</title>
  </head>
  <body class="text-primary">
    <!--     <Gate /> -->
    <NavBar />
    <div class="c-grid-wrapper">
      <div class="sidenav bg-slate-100/80 border-slate-200 border">
        <SideNav />
      </div>
      <main class="c-main bg-surface">
        <slot />
      </main>
      <div class="c-metadata bg-surface"><MetadataPanel /></div>
    </div>
    <!--    <footer>FOOTER</footer> -->
  </body>
</html>

<style>
  .c-grid-wrapper {
    display: grid;
    grid-template-columns: 25rem 4fr 1fr;
    grid-template-areas: 'sidenav main metadata';
  }

  .c-main {
    grid-area: 'main';
  }

  .c-sidenav {
    grid-area: 'sidenav';
  }

  .c-metadata {
    grid-area: 'metadata';
  }
</style>
