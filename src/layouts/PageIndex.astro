---
import Layout from '@/layouts/Layout.astro'

interface Props {
  title: string
  tabTitel?: string
}

const { title, tabTitel = title } = Astro.props
---

<Layout title={tabTitel}>
  <main class="pt-12 pb-32 bg-slate-50">
    <h1 class="text-center font-semibold font-serif text-3xl">{title}</h1>
    <div class="mx-auto mt-8 max-w-3xl">
      <slot />
    </div>
  </main>
</Layout>
