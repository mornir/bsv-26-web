---
import Layout from '@/layouts/Layout.astro'
import TocNav from '@/components/toc/TocNav.astro'

interface Props {
  title: string
  tabTitel?: string
}

const { title, tabTitel = title } = Astro.props
---

<Layout title={tabTitel}>
  <div class="mt-8 grid grid-cols-[320px_1fr_320px] gap-x-4 px-4">
    <TocNav />
    <main class="col-start-2 max-w-3xl justify-self-center" data-pagefind-body>
      <slot name="context" />
      <h1 class="text-center font-semibold font-serif text-3xl mt-8 mb-6">
        {title}
      </h1>
      <slot />
    </main>
    <slot name="on-this-page" />
  </div>
</Layout>
