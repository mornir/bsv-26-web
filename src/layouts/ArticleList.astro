---
import Layout from '@/layouts/Layout.astro'
import TocNav from '@/components/toc/TocNav.astro'

interface Props {
  title: string
  tabTitel?: string
}

const { title, tabTitel = title } = Astro.props
---

<Layout title={tabTitel}>
  <slot name="toc" />
  <main class="mx-auto mt-8 max-w-3xl">
    <h1 class="text-center font-semibold font-serif text-3xl mb-8">
      {title}
    </h1>
    <slot />
  </main>
</Layout>
